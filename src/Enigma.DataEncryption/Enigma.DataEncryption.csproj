<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Mirrors Enigma.Core's TFMs so no consumer of Enigma.Core is excluded from this library. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <!-- Ships the XML doc file consumers get IntelliSense from; also makes a missing doc comment
         on a public member a build error under TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- NuGet packaging metadata (FEATURE-07DA PHASE01). GeneratePackageOnBuild is deliberately
       absent: the package is packed explicitly by the release step, never on every local build.
       No symbol properties either (IncludeSymbols / SymbolPackageFormat / PublishRepositoryUrl /
       EmbedUntrackedSources) — a release ships exactly one file, the .nupkg, as Enigma.Core does. -->
  <PropertyGroup>
    <PackageId>Enigma.DataEncryption</PackageId>
    <Version>1.0.0</Version>
    <Title>Enigma.DataEncryption — Stream Encryption for .NET</Title>
    <Description>Stream-based authenticated encryption for .NET, built on Enigma.Core. Encrypts data and streams into a self-describing binary container whose header is authenticated as AEAD associated data and carries a key-confirmation tag for fast, uniform wrong-credential detection. Key establishment by PBKDF2 or Argon2id password derivation, RSAES-OAEP-SHA256 key transport, or post-quantum ML-KEM (512/768/1024) key encapsulation; payloads encrypted with AES-256, Twofish-256, Serpent-256 or Camellia-256 in GCM. Every operation is async with optional progress reporting and cancellation, headers can be inspected without decrypting, and one registration call wires the services into Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>enigma encryption decryption cryptography stream aes gcm twofish serpent camellia rsa oaep ml-kem post-quantum pbkdf2 argon2 dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryUrl>https://github.com/enigmalibs/Enigma.DataEncryption</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/enigmalibs/Enigma.DataEncryption</PackageProjectUrl>
    <PackageReleaseNotes>First release. Four encryption methods — PBKDF2 and Argon2id passwords, RSA-OAEP key transport, and post-quantum ML-KEM key encapsulation — over one self-describing container format whose header is authenticated as AEAD associated data and carries a key-confirmation tag, making the construction key-committing and wrong-credential failure fast and uniform. Four 256-bit GCM ciphers (AES, Twofish, Serpent, Camellia), async stream APIs with progress and cancellation, header inspection without decryption, file-path helpers, and one-call dependency-injection registration. Targets netstandard2.0, net8.0 and net10.0. The container format is not compatible with the predecessor Enigma.Cryptography.DataEncryption. See RELEASENOTES.md for the full details.</PackageReleaseNotes>
  </PropertyGroup>
  <!-- PackageReadmeFile / PackageLicenseFile name the files; this is what actually puts them in
       the package. Both live at the repository root, two levels above this project. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- LangVersion / Nullable / ImplicitUsings / TreatWarningsAsErrors are deliberately absent:
       they come from Directory.Build.props and must never be repeated per-project. No Version
       attributes either — versions live in Directory.Packages.props (CPM). -->
  <ItemGroup>
    <PackageReference Include="Enigma.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <!-- System.Buffers (Span/Memory/ArrayPool support) is framework-provided on net8.0+; it is only
       needed as an explicit package on netstandard2.0. Referencing it on net8.0/net10.0 would raise
       NU1510 and fail the zero-warnings build. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" />
  </ItemGroup>
  <!-- PolySharp: polyfills modern C# on netstandard2.0. Compile-only (PrivateAssets=all). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
