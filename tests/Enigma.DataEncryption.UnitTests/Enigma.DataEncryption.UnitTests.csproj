<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target so net8.0 code paths (and the netstandard2.0 polyfill surface reachable through
         them) are actually exercised alongside net10.0. netstandard2.0 is never a test TFM. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.DataEncryption/Enigma.DataEncryption.csproj" />
  </ItemGroup>
  <!-- Fixture copy-glob: files the suite loads by relative path next to the test assembly. The
       golden-vector suite depends on this convention being in place — encrypted-file fixtures
       (*.bin), PEM key material (*.pem), raw ML-KEM key bytes (*.key), CSV vector tables (*.csv)
       and expected-output text (*.txt). -->
  <ItemGroup>
    <None Update="**/*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.key">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
